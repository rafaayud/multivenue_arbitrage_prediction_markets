# =============================================================================
# Prediction Markets — environment variables
# =============================================================================
# Safe configuration template. Copy to .env and fill in your own credentials.
# The populated .env file is ignored and must never be committed.
#
# Format:
#   KEY=value
#
# No spaces around "=".
# =============================================================================

# -----------------------------------------------------------------------------
# Market data workers mode
# -----------------------------------------------------------------------------
# active: active market data workers
# passive: passive market data workers
# -----------------------------------------------------------------------------
# The event-dashboard Compose stack disables workers and recurring markets.
MARKET_DATA_WORKERS_MODE=disabled
MARKET_RECURRING_MARKETS_ENABLED=0

# -----------------------------------------------------------------------------
# API key — dashboard / trading control
# -----------------------------------------------------------------------------
# FastAPI: secret sent by the dashboard in the X-Trading-Key header.
TRADING_API_KEY=


# -----------------------------------------------------------------------------
# Polynode — Polymarket order-book WebSocket
# -----------------------------------------------------------------------------
# Required for:
#   PolynodeMarketDataStreamAdapter
#
# Get your key at:
#   https://polynode.dev
#
# POLY_NODE_API and POLYNODE_API_KEY are aliases; defining one is enough.
# You may paste the key with or without the "pn_" / "pn_live_" prefix.
# -----------------------------------------------------------------------------

POLY_NODE_API=
POLYNODE_API_KEY=
# POLYNODE_REST_API_KEY=
POLYNODE_WS_URL=wss://ob.polynode.dev/ws


# -----------------------------------------------------------------------------
# Polymarket — trading and CLOB
# -----------------------------------------------------------------------------
# Required for:
#   PolymarketExecutionAdapter
#   get_polymarket_http_client()
#
# POLYMARKET_PK:
#   Wallet private key (0x...).
#
# POLYMARKET_SIGNATURE_TYPE:
#   0 = EOA, 1 = Magic/email, 2 = browser proxy, 3 = Gnosis Safe.
#
# POLYMARKET_FUNDER:
#   Funder/proxy address when signature_type != 0.
#
# POLYMARKET_API_KEY / POLYMARKET_API_SECRET / POLYMARKET_PASSPHRASE:
#   CLOB L2 credentials (derived or generated with create_or_derive_api_key).
#
# POLYMARKET_RELAYER_API_KEY / POLYMARKET_RELAYER_API_KEY_ADDRESS:
#   Gasless smart-wallet credentials used for split, merge, redeem, and
#   approvals. Create them in polymarket.com -> Settings -> API Keys ->
#   Relayer API Keys. Copy the fields named API Key and Relayer API Key Address.
# -----------------------------------------------------------------------------

POLYMARKET_PK=
POLYMARKET_SIGNATURE_TYPE=
POLYMARKET_FUNDER=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=


# -----------------------------------------------------------------------------
# Limitless — trading
# -----------------------------------------------------------------------------
# Required for:
#   LimitlessExecutionAdapter (smoke tests and live execution)
#
# LIMITLESS_PRIVATE_KEY:
#   Wallet private key used to sign orders.
#
# LIMITLESS_API_KEY:
#   Optional API key passed to the official HTTP client.
#
# LIMITLESS_RPC_URL:
#   Base Mainnet JSON-RPC endpoint used for split, merge, redeem, and USDC
#   approval transactions. The signer wallet must hold ETH on Base for gas.
# -----------------------------------------------------------------------------

LIMITLESS_API_KEY=
LIMITLESS_API_SECRET=
LIMITLESS_PRIVATE_KEY=
LIMITLESS_RPC_URL=


# -----------------------------------------------------------------------------
# Predict.fun — REST and WebSocket
# -----------------------------------------------------------------------------
# Required on mainnet for discovery, snapshot, and WebSocket adapters.
# Request an API key at https://discord.gg/predictdotfun.
# Testnet (https://api-testnet.predict.fun) does not require a key for REST.
# The Predict web app creates a Smart Wallet. Both variables are mandatory:
# PREDICT_ACCOUNT_ADDRESS holds USDT and positions; PREDICT_PRIVY_PRIVATE_KEY signs.
# Grant the Smart Wallet's USDT and ERC-1155 exchange approvals before live trading.
# Never share the Privy key or commit it.
# -----------------------------------------------------------------------------

PREDICT_API_KEY=
PREDICT_ACCOUNT_ADDRESS=
PREDICT_PRIVY_PRIVATE_KEY=
PREDICT_TRANSACTION_GAS_PRICE_GWEI=0.05
# Maximum catalog age; rollover boundaries invalidate matching cycle pages earlier.
PREDICT_DISCOVERY_CACHE_SECONDS=60
# Smooth metadata reads below Predict's per-key limit; execution uses separate capacity.
PREDICT_READ_REQUESTS_PER_SECOND=3
# Refresh the execution JWT from the lifecycle task before its expiry window.
PREDICT_AUTH_REFRESH_SECONDS=10
# Time a nonterminal Predict LIMIT may rest before explicit cancellation.
PREDICT_RESTING_WINDOW_MS=1000
# Force FOK on Predict LIMIT orders; disabled keeps the timed partial-fill window.
PREDICT_LIMIT_FOK_ENABLED=0
# Recovery-only on-chain invalidation; requires finalized blocks and eth_getLogs.
PREDICT_ONCHAIN_CANCEL_ENABLED=0
PREDICT_CANCELLATION_RPC_URL=
PREDICT_ONCHAIN_CANCEL_MAX_FEE_BNB=0.0001


# -----------------------------------------------------------------------------
# PostgreSQL — persistence
# -----------------------------------------------------------------------------
# Required for:
#   persistence smoke tests and services that use Postgres
#
# Example:
#   POSTGRES_DSN=postgresql://user:password@localhost:5432/prediction_markets
# DATABASE_URL is an alias accepted by the runtime projector.
# -----------------------------------------------------------------------------

POSTGRES_DSN=
DATABASE_URL=

# Event pipeline and durable PostgreSQL projection.
JOURNAL_PATH=data/trading.log
JOURNAL_SYNC_INTERVAL_MS=10
JOURNAL_SEGMENT_SIZE_MB=64
JOURNAL_SNAPSHOT_DIR=data/trading.log.snapshots
JOURNAL_SNAPSHOT_INTERVAL_SECONDS=30
# Keep dry-run until snapshot recovery has been validated in the target environment.
JOURNAL_RETENTION_MODE=dry-run
POSTGRES_PROJECTOR_ENABLED=1
MIGRATIONS_DIR=migrations
MARKET_WORKER_ENABLED=1
MARKET_REFRESH_SECONDS=15

# Start the local receiver stack with:
#   docker compose --profile alerting up -d alertmanager
# The app runs on the host and submits only to Alertmanager; SMTP, PagerDuty,
# and push delivery all happen outside the trading hot path.
# ALERTMANAGER_URL=http://127.0.0.1:9093
ALERTMANAGER_URL=
# Each address is retained for audit. Physical routing remains in Alertmanager.
# ALERT_RECIPIENTS_JSON=[{"id":"ops-email","channel":"email","address":"operator@gmail.com"},{"id":"pagerduty-on-call","channel":"sms","address":"+34000000000"},{"id":"mobile-app","channel":"push","address":"prediction-markets-mobile"}]
ALERT_RECIPIENTS_JSON=[]
ALERTMANAGER_TIMEOUT_SECONDS=10
ALERT_DELIVERY_BATCH_SIZE=32
ALERT_DELIVERY_POLL_SECONDS=1
ALERT_DELIVERY_LEASE_SECONDS=300
# Scan active incidents for policy-driven severity changes outside the hot path.
ALERT_ESCALATION_POLL_SECONDS=60

# Alertmanager receiver configuration. Keep these values in .env, which is ignored.
# Gmail requires 2-Step Verification and a 16-character app password.
ALERT_GMAIL_ADDRESS=operator@gmail.com
ALERT_GMAIL_TO=operator@gmail.com
ALERT_GMAIL_APP_PASSWORD=
# PagerDuty Events API v2 integration key. PagerDuty notification rules decide SMS.
ALERT_PAGERDUTY_ROUTING_KEY=
# HTTPS API endpoint and dedicated bearer token used only by Alertmanager.
ALERT_PUSH_WEBHOOK_URL=https://example.invalid/webhooks/alertmanager/push
ALERTMANAGER_WEBHOOK_TOKEN=
# Static application recipient ID -> FCM device registration token mapping.
ALERT_PUSH_RECIPIENT_TOKENS_JSON={"mobile-app":"FCM_DEVICE_TOKEN"}
# Firebase service-account file. Keep the JSON outside source control.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Must remain below Alertmanager's five-second webhook timeout.
ALERT_PUSH_TIMEOUT_SECONDS=4


# -----------------------------------------------------------------------------
# AGG — arbitrage and order-book streams
# -----------------------------------------------------------------------------
# Required for:
#   AggArbitrageStreamAdapter
#   AggOrderBookStreamAdapter
#
# AGG_APP_ID:
#   Public AGG client app ID.
#
# AGG_ORIGIN:
#   Origin allowed by the AGG server (e.g. http://localhost:3000).
# -----------------------------------------------------------------------------

AGG_APP_ID=
AGG_ORIGIN=
AGG_APP_API_KEY=
AGG_ADMIN_KEY=
AGG_PAPER_ACCOUNT_ID=


# -----------------------------------------------------------------------------
# Kalshi — authenticated WebSocket
# -----------------------------------------------------------------------------
# Required for:
#   KalshiMarketDataStreamAdapter
#
# Kalshi's public REST API for discovery/snapshots does not need keys.
#
# KALSHI_API_KEY_ID:
#   Your API key ID from the Kalshi dashboard.
#
# KALSHI_PRIVATE_KEY_PATH:
#   Path to the private-key PEM file.
#   Example:
#   KALSHI_PRIVATE_KEY_PATH=kalshi_private.pem
# -----------------------------------------------------------------------------

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=


# -----------------------------------------------------------------------------
# Local development (macOS)
# -----------------------------------------------------------------------------
# Fix for macOS Desktop UF_HIDDEN skipping editable .pth (Python 3.13).
# Usually unnecessary when launching with `uv run`.
PYTHONPATH=src
